# ── Provider API Keys ─────────────────────────────────────────────────────────
# Use GROQ_API_KEY for Groq-native model IDs like llama-3.1-8b-instant.
GROQ_API_KEY=your_groq_api_key_here
# Use OPENROUTER_API_KEY for OpenRouter model slugs like qwen/qwen3-32b:free.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Model Configuration ────────────────────────────────────────────────────────
# If GENERATION_MODEL contains a slash, the app routes requests through OpenRouter.
# For Groq-native models, use IDs like:
#   llama-3.3-70b-versatile  |  llama-3.1-8b-instant  |  mixtral-8x7b-32768
GENERATION_MODEL=qwen/qwen3-32b
JUDGE_MODEL=openai/gpt-oss-120b

# ── Generation Parameters ──────────────────────────────────────────────────────
NUM_JOBS=50
NUM_RESUMES_PER_JOB=5
JOB_MAX_COMPLETION_TOKENS=2200
RESUME_MAX_COMPLETION_TOKENS=3000
